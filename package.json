{
  "name": "@echokovo/pi-update-summary",
  "version": "0.3.0",
  "description": "Summarize changelogs for installed Pi package updates on demand.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "files": [
    "index.ts",
    "settings.ts",
    "summary.ts",
    "changelog-store.ts",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Echokovo/pi-update-summary.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --test *.test.ts",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run",
    "check": "npm run typecheck && npm test && npm run pack:check"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.6.0",
    "@earendil-works/pi-tui": "^1.6.0",
    "@types/node": "^24.0.0",
    "typebox": "^1.3.7",
    "typescript": "^6.0.3"
  },
  "author": "Michael Bøcker-Larsen"
}
